{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moewatch",
  "version": "0.1.16",
  "identifier": "com.moewatch.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/moewatch-server"
    ],
    "resources": {
      "../dist/": "dist/",
      "../native/discord-party/build/out/": "discord/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMTExMEE0NTNDQTc5MjEKUldRaGVjcFRwQkFSeWh5TGRTWldFZktRZE5hbFpreEoxUjJwTWM2QzZVVHBETmhyMG9qTHV5alcK",
      "endpoints": [
        "https://github.com/mqt464/Moewatch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
